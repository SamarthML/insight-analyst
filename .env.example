# Copy to .env and edit as needed. Every default works offline — no API keys.

# --- Embeddings ---------------------------------------------------------
# "ollama" (default) or "sentence-transformers"
EMBEDDING_BACKEND=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Used only when EMBEDDING_BACKEND=sentence-transformers
SENTENCE_TRANSFORMERS_MODEL=BAAI/bge-small-en-v1.5

# --- Corpus fetching ----------------------------------------------------
# SEC's fair-access policy requires a real contact address in the User-Agent
# of automated requests to EDGAR. Used only for that header.
SEC_CONTACT_EMAIL=you@example.com

# --- Chunking -----------------------------------------------------------
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=100

# --- Vector store -------------------------------------------------------
CHROMA_COLLECTION=insight_analyst
CHROMA_MAX_BATCH=4000
