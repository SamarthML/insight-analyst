# Copy to .env and edit as needed.
#
# Retrieval, embedding, chunking and reranking run entirely offline and need no
# API key. Generation and evaluation judging do not: selecting a hosted provider
# sends prompt and corpus text to that provider. Only GROQ_API_KEY below is
# needed for the documented defaults.

# --- Hosted judge (generation + RAGAS scoring) ---------------------------
# Required by `--llm-provider groq`, which is the default in every evaluation
# and report-generation example in the README:
#     python -m src.evaluation.run_eval --ragas --llm-provider groq
#     python -m src.reporting.generate_report "<topic>" --llm-provider groq
# Leave it unset to stay fully offline; pass `--llm-provider ollama` instead
# (slower, and lower quality on CPU-only hardware).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# --- Embeddings ---------------------------------------------------------
# "ollama" (default) or "sentence-transformers"
EMBEDDING_BACKEND=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Used only when EMBEDDING_BACKEND=sentence-transformers
SENTENCE_TRANSFORMERS_MODEL=BAAI/bge-small-en-v1.5

# --- Corpus fetching ----------------------------------------------------
# SEC's fair-access policy requires a real contact address in the User-Agent
# of automated requests to EDGAR. Used only for that header.
SEC_CONTACT_EMAIL=you@example.com

# --- Chunking -----------------------------------------------------------
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=100

# --- Vector store -------------------------------------------------------
CHROMA_COLLECTION=insight_analyst
CHROMA_MAX_BATCH=4000
